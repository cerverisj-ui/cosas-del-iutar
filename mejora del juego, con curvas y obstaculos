import math, random, tkinter as tk, traceback

W, H = 900, 600
PISTAS = {
    "1": ("Autopista Nocturna", "#101828", "#2b3a55", "#182c25", "#262930", 280.0, 1.0),
    "2": ("Circuito Costero", "#4da6ff", "#b3d9ff", "#2e8b57", "#383b42", 265.0, 0.95),
    "3": ("Ruta Alpina Nieve", "#8faec9", "#d9e6f2", "#e6eef5", "#9db4c7", 225.0, 0.42),
}

def obtener_auto(idx):
    mod = idx % 5
    if mod == 0:
        return ("Ferrari SF90", "#d40000", "#ff4d4d", "#7a0000", "#ffcc00", "ferrari")
    if mod == 1:
        return ("Lamborghini SVJ", "#52b318", "#8ce645", "#2c6609", "#ffffff", "lambo")
    if mod == 2:
        return ("BMW M4 Comp", "#00665e", "#1aa398", "#003833", "#e6e6e6", "bmw")
    if mod == 3:
        return ("Porsche 911 GT3", "#f5c400", "#ffe066", "#b38f00", "#111111", "porsche")
    return ("Bugatti Chiron", "#0047b3", "#3385ff", "#002666", "#00ccff", "bugatti")

st = {
    "p": "1", "car": 0, "z": 0.0, "v": 0.0, "x": 0.0, "vx": 0.0,
    "luz": True, "lenta": False, "t": 0.0,
    "volcado": False, "choque_timer": 0.0, "puntos": 0
}
teclas = set()

# Carros de tráfico
trafico = [
    {"z": 240.0, "x": -0.55, "v": 85.0, "c": "#c0c5ce"},
    {"z": 540.0, "x": 0.55, "v": 95.0, "c": "#2b303a"},
    {"z": 840.0, "x": 0.0, "v": 80.0, "c": "#b83227"},
]

# Obstáculos en la carretera (conos y barreras)
obstaculos = [
    {"z": 360.0, "x": 0.0, "tipo": "barrera"},
    {"z": 680.0, "x": -0.55, "tipo": "cono"},
    {"z": 980.0, "x": 0.55, "tipo": "barrera"},
    {"z": 1250.0, "x": -0.25, "tipo": "cono"},
]

root = tk.Tk()
root.title("Superdeportivos 3D - Curvas, Obstáculos y Choques")
root.resizable(False, False)
cv = tk.Canvas(root, width=W, height=H, bg="#101828", highlightthickness=0)
cv.pack()


def k_down(e):
    k = e.keysym.lower()
    teclas.add(k)
    if k in PISTAS:
        st["p"] = k
    elif k == "c":
        st["car"] = st.get("car") + 1
    elif k == "l":
        st["luz"] = not st.get("luz")
    elif k == "g":
        st["lenta"] = not st.get("lenta")
    elif k == "r":
        st["v"], st["x"], st["vx"], st["volcado"], st["choque_timer"] = 0.0, 0.0, 0.0, False, 0.0
        st["puntos"] = 0


def k_up(e):
    teclas.discard(e.keysym.lower())


root.bind("<KeyPress>", k_down)
root.bind("<KeyRelease>", k_up)


# Función matemática que genera las curvas según la distancia z
def obtener_curvatura(z_pos):
    # Combina dos ondas seno para crear curvas largas y curvas cerradas
    return math.sin(z_pos * 0.0022) * 1.15 + math.sin(z_pos * 0.0051) * 0.55


def dibujar_auto(cx, cy, giro):
    nombre, col, bri, som, casco, tipo = obtener_auto(st.get("car"))
    inc = giro * 10
    y = cy + (math.sin(st.get("t") * 28) * 1.4 if st.get("v") > 10 else 0)
    led = "#ff1a1a" if st.get("luz") else "#660a0a"
    cab = "#16181d" if tipo == "bugatti" else col

    if st.get("volcado"):
        cv.create_oval(cx - 140, y + 32, cx + 140, y + 66, fill="#0b0c0e", outline="")
        cv.create_polygon(cx - 84, y + 22, cx + 84, y + 22, cx + 62, y + 52, cx - 62, y + 52, fill=som, outline="")
        cv.create_polygon(cx - 118, y - 4, cx + 118, y - 4, cx + 104, y + 26, cx - 104, y + 26, fill=col, outline="")
        cv.create_polygon(cx - 110, y - 22, cx + 110, y - 22, cx + 118, y - 4, cx - 118, y - 4, fill="#1e2229", outline="")
        cv.create_rectangle(cx - 122, y - 38, cx - 86, y + 4, fill="#111214", outline="#333")
        cv.create_rectangle(cx + 86, y - 38, cx + 122, y + 4, fill="#111214", outline="#333")
        humo_x = math.sin(st.get("t") * 8) * 15
        cv.create_oval(cx - 45 + humo_x, y - 65, cx + 15 + humo_x, y - 25, fill="#555b66", outline="")
        cv.create_oval(cx - 15 - humo_x, y - 85, cx + 55 - humo_x, y - 40, fill="#6e7582", outline="")
        return nombre

    cv.create_oval(cx - 135, y + 36, cx + 135, y + 66, fill="#0b0c0e", outline="")
    cv.create_rectangle(cx - 122, y + 14, cx - 86, y + 56, fill="#111214", outline="")
    cv.create_rectangle(cx + 86, y + 14, cx + 122, y + 56, fill="#111214", outline="")
    cv.create_polygon(cx - 114, y + 44, cx + 114, y + 44, cx + 106, y + 20, cx - 106, y + 20, fill="#181a1f", outline="")

    cv.create_polygon(cx - 118, y + 22, cx + 118, y + 22, cx + 104, y - 12, cx - 104, y - 12, fill=col, outline="")
    cv.create_polygon(cx - 100, y - 12, cx + 100, y - 12, cx + 85, y - 21, cx - 85, y - 21, fill=bri, outline="")
    if tipo == "bugatti":
        cv.create_polygon(cx - 54, y + 22, cx + 54, y + 22, cx + 46, y - 21, cx - 46, y - 21, fill="#16181d", outline="")

    cv.create_polygon(cx - 84 + inc, y - 18, cx + 84 + inc, y - 18, cx + 62 + inc, y - 54, cx - 62 + inc, y - 54, fill=som, outline="")
    cv.create_polygon(cx - 78 + inc, y - 18, cx + 78 + inc, y - 18, cx + 58 + inc, y - 51, cx - 58 + inc, y - 51, fill=cab, outline="")
    cv.create_polygon(cx - 68 + inc, y - 21, cx + 68 + inc, y - 21, cx + 50 + inc, y - 47, cx - 50 + inc, y - 47, fill="#1c2633", outline="")

    px = cx - 26 + inc + giro * 5
    cv.create_oval(px - 13, y - 33, px + 13, y - 19, fill="#22252a", outline="")
    cv.create_oval(px - 8, y - 45, px + 8, y - 30, fill=casco, outline="#111")

    if tipo in ("porsche", "lambo", "bmw"):
        ay = y - 33 if tipo == "porsche" else y - 29
        cv.create_rectangle(cx - 98 + inc // 2, ay, cx + 98 + inc // 2, ay + 6, fill="#14161a", outline="")
        cv.create_rectangle(cx - 64, ay + 6, cx - 58, y - 15, fill="#14161a", outline="")
        cv.create_rectangle(cx + 58, ay + 6, cx + 64, y - 15, fill="#14161a", outline="")

    if tipo in ("porsche", "bugatti"):
        cv.create_rectangle(cx - 106, y - 3, cx + 106, y + 3, fill=led, outline="")
    elif tipo == "ferrari":
        cv.create_oval(cx - 101, y - 5, cx - 83, y + 7, fill=led, outline="")
        cv.create_oval(cx - 73, y - 5, cx - 55, y + 7, fill=led, outline="")
        cv.create_oval(cx + 55, y - 5, cx + 73, y + 7, fill=led, outline="")
        cv.create_oval(cx + 83, y - 5, cx + 101, y + 7, fill=led, outline="")
    else:
        cv.create_rectangle(cx - 100, y - 3, cx - 52, y + 5, fill=led, outline="")
        cv.create_rectangle(cx + 52, y - 3, cx + 100, y + 5, fill=led, outline="")

    cv.create_oval(cx - 72, y + 28, cx - 60, y + 40, fill="#b0b8c4", outline="#222")
    cv.create_oval(cx - 56, y + 28, cx - 44, y + 40, fill="#b0b8c4", outline="#222")
    cv.create_oval(cx + 44, y + 28, cx + 56, y + 40, fill="#b0b8c4", outline="#222")
    cv.create_oval(cx + 60, y + 28, cx + 72, y + 40, fill="#b0b8c4", outline="#222")

    if st.get("choque_timer") > 0:
        for _ in range(10):
            sx = cx + random.randint(-120, 120)
            sy = y + random.randint(-20, 45)
            cv.create_oval(sx - 4, sy - 4, sx + 4, sy + 4, fill="#ffcc00", outline="#ff4400")

    return nombre


def dibujar_carro_trafico(px, py, esc, color):
    w = 210 * esc
    h = 95 * esc
    if w < 3:
        return
    # Sombra
    cv.create_oval(px - w * 0.55, py - h * 0.1, px + w * 0.55, py + h * 0.15, fill="#0d0e12", outline="")
    # Llantas
    cv.create_rectangle(px - w * 0.48, py - h * 0.35, px - w * 0.32, py + h * 0.05, fill="#111", outline="")
    cv.create_rectangle(px + w * 0.32, py - h * 0.35, px + w * 0.48, py + h * 0.05, fill="#111", outline="")
    # Carrocería inferior
    cv.create_polygon(
        px - w * 0.5, py - h * 0.12,
        px + w * 0.5, py - h * 0.12,
        px + w * 0.44, py - h * 0.55,
        px - w * 0.44, py - h * 0.55,
        fill=color, outline="#181a1f"
    )
    # Cabina y vidrio trasero
    cv.create_polygon(
        px - w * 0.36, py - h * 0.55,
        px + w * 0.36, py - h * 0.55,
        px + w * 0.26, py - h * 0.92,
        px - w * 0.26, py - h * 0.92,
        fill="#1e2633", outline=color
    )
    # Luces traseras rojas
    cv.create_rectangle(px - w * 0.45, py - h * 0.42, px - w * 0.25, py - h * 0.30, fill="#ff2222", outline="")
    cv.create_rectangle(px + w * 0.25, py - h * 0.42, px + w * 0.45, py - h * 0.30, fill="#ff2222", outline="")


def dibujar_obstaculo(px, py, esc, tipo):
    if tipo == "barrera":
        w = 155 * esc
        h = 68 * esc
        if w < 3:
            return
        # Patas metálicas
        cv.create_rectangle(px - w * 0.42, py - h * 0.5, px - w * 0.34, py, fill="#555", outline="")
        cv.create_rectangle(px + w * 0.34, py - h * 0.5, px + w * 0.42, py, fill="#555", outline="")
        # Tablero naranja con franjas blancas
        cv.create_rectangle(px - w * 0.5, py - h, px + w * 0.5, py - h * 0.45, fill="#ff6600", outline="#222")
        cv.create_rectangle(px - w * 0.3, py - h, px - w * 0.12, py - h * 0.45, fill="#ffffff", outline="")
        cv.create_rectangle(px + w * 0.12, py - h, px + w * 0.3, py - h * 0.45, fill="#ffffff", outline="")
    else:
        # Cono de tráfico
        w = 52 * esc
        h = 64 * esc
        if w < 2:
            return
        cv.create_rectangle(px - w * 0.55, py - h * 0.12, px + w * 0.55, py, fill="#1a1a1a", outline="")
        cv.create_polygon(
            px - w * 0.42, py - h * 0.12,
            px + w * 0.42, py - h * 0.12,
            px + w * 0.12, py - h,
            px - w * 0.12, py - h,
            fill="#ff5500", outline=""
        )
        cv.create_polygon(
            px - w * 0.30, py - h * 0.42,
            px + w * 0.30, py - h * 0.42,
            px + w * 0.22, py - h * 0.65,
            px - w * 0.22, py - h * 0.65,
            fill="#ffffff", outline=""
        )


def loop():
    dt = 0.016 * (0.35 if st.get("lenta") else 1.0)
    st["t"] = st.get("t") + dt
    if st.get("choque_timer") > 0:
        st["choque_timer"] = max(0.0, st.get("choque_timer") - dt)

    nom_p, cielo, hor, pasto, via, vmax, agarre = PISTAS.get(st.get("p"))
    hy = int(H * 0.44)

    # Curvatura actual donde está el jugador
    curva_actual = obtener_curvatura(st.get("z") + 15.0)

    if st.get("volcado"):
        st["v"] = max(0.0, st.get("v") - 120 * dt)
        giro = 0
    else:
        acel = (1 if "w" in teclas or "up" in teclas else 0) - (1 if "s" in teclas or "down" in teclas else 0)
        giro = (1 if "d" in teclas or "right" in teclas else 0) - (1 if "a" in teclas or "left" in teclas else 0)

        # Penalización de velocidad si te sales al pasto/nieve
        en_pasto = abs(st.get("x")) > 0.92
        vel_limite = vmax * (0.55 if en_pasto else 1.0)

        st["v"] = max(0.0, min(vel_limite, st.get("v") + (115 * dt if acel > 0 else (-180 * dt if acel < 0 else -50 * dt))))
        st["vx"] = (st.get("vx") + giro * 3.1 * agarre * dt) * math.pow(0.02, agarre * dt)

        if st.get("v") > 2:
            # Fuerza centrífuga de la curva te empuja hacia el lado contrario si vas rápido
            fuerza_centrifuga = -curva_actual * (st.get("v") / 195.0) * 0.72
            st["x"] = max(-1.25, min(1.25, st.get("x") + (st.get("vx") + fuerza_centrifuga) * (st.get("v") / 110.0) * dt * 2.4))

    st["z"] = st.get("z") + st.get("v") * dt * 5.2

    cv.delete("all")
    cv.create_rectangle(0, 0, W, hy - 35, fill=cielo, outline="")
    cv.create_rectangle(0, hy - 35, W, hy, fill=hor, outline="")

    # Montañas de fondo que se desplazan con las curvas para efecto 3D
    shift_fondo = (curva_actual * 120 + st.get("z") * 0.04) % W
    for m in range(-1, 3):
        mx = m * 450 - shift_fondo
        cv.create_polygon(mx, hy, mx + 140, hy - 75, mx + 290, hy, fill="#1a2436" if st["p"] == "1" else "#5c768d", outline="")
        cv.create_polygon(mx + 200, hy, mx + 340, hy - 55, mx + 480, hy, fill="#141c2b" if st["p"] == "1" else "#4a6278", outline="")

    # Renderizado de la carretera en 3D con curvas
    nf = H - hy
    for y in range(0, nf, 4):
        py = hy + y
        pr = (y + 1) / float(nf)
        z_linea = (1.0 / pr) * 18.0
        z_mundo = st.get("z") + z_linea

        # Desplazamiento lateral por la curva en perspectiva (más fuerte hacia el horizonte)
        curva_linea = obtener_curvatura(z_mundo)
        desfase_curva = curva_linea * math.pow(1.0 - pr, 1.85) * (W * 0.42)

        alt = int(z_mundo * 0.4) % 2 == 0
        cv.create_rectangle(0, py, W, py + 4, fill=pasto if alt else ("#13221d" if st["p"] != "3" else "#d5e2ed"), outline="")

        av = 48 + pr * (W * 0.68)
        cx = W / 2 - st.get("x") * pr * (W * 0.28) + desfase_curva
        borde = 6 + pr * 22

        cv.create_rectangle(cx - av / 2 - borde, py, cx + av / 2 + borde, py + 4, fill="#d9dde6" if alt else "#b82525", outline="")
        cv.create_rectangle(cx - av / 2, py, cx + av / 2, py + 4, fill=via if alt else "#323640", outline="")
        if alt:
            lw = max(2, pr * 6)
            cv.create_rectangle(cx - av * 0.17 - lw, py, cx - av * 0.17 + lw, py + 4, fill="#e6ecf5", outline="")
            cv.create_rectangle(cx + av * 0.17 - lw, py, cx + av * 0.17 + lw, py + 4, fill="#e6ecf5", outline="")

    # Lista de elementos 3D a dibujar ordenados de lejos a cerca (Painter's Algorithm)
    objetos_3d = []

    # 1. Edificios / árboles laterales siguiendo la curva
    for i in range(16, 0, -1):
        ze = i * 45 - (st.get("z") % 45)
        if ze > 8:
            objetos_3d.append((ze, "edificio", None))

    # 2. Actualizar y verificar colisión con OBSTÁCULOS
    for obs in obstaculos:
        if obs.get("z") - st.get("z") < -20:
            obs["z"] = st.get("z") + random.uniform(550, 1100)
            obs["x"] = random.choice([-0.6, -0.25, 0.25, 0.6])
            obs["tipo"] = random.choice(["cono", "barrera"])
            if not st.get("volcado"):
                st["puntos"] += 50

        rz = obs.get("z") - st.get("z")
        ancho_col = 0.30 if obs["tipo"] == "barrera" else 0.20

        # Colisión con obstáculo
        if 12 <= rz <= 28 and abs(st.get("x") - obs.get("x")) < ancho_col and not st.get("volcado"):
            obs["z"] = st.get("z") + random.uniform(600, 1000)
            st["choque_timer"] = 0.5
            st["v"] = st.get("v") * 0.45
            st["vx"] = 1.6 if st.get("x") >= obs.get("x") else -1.6
            st["puntos"] = max(0, st.get("puntos") - 50)

        if 8 < rz < 440:
            objetos_3d.append((rz, "obstaculo", obs))

    # 3. Actualizar y verificar colisión con CARROS DE TRÁFICO
    for a in trafico:
        a["z"] = a.get("z") + a.get("v") * dt * 5.2
        if a.get("z") - st.get("z") < -20:
            a["z"] = st.get("z") + random.uniform(450, 850)
            a["x"] = random.choice([-0.55, 0.0, 0.55])
            if not st.get("volcado"):
                st["puntos"] = st.get("puntos") + 100

        rz = a.get("z") - st.get("z")

        # Colisión con carro
        if 12 <= rz <= 34 and abs(st.get("x") - a.get("x")) < 0.34 and not st.get("volcado"):
            a["z"] = st.get("z") + random.uniform(450, 750)
            st["choque_timer"] = 0.65
            if st.get("v") >= 175.0:
                st["volcado"] = True
                st["v"] = st.get("v") * 0.55
            else:
                st["v"] = st.get("v") * 0.35
                st["vx"] = 2.0 if st.get("x") >= a.get("x") else -2.0

        if 8 < rz < 440:
            objetos_3d.append((rz, "carro", a))

    # Ordenar todos los objetos de mayor distancia (más lejos) a menor distancia (más cerca)
    objetos_3d.sort(key=lambda item: item[0], reverse=True)

    # Dibujar todos los objetos 3D siguiendo la curva de la pista
    for rz, tipo_obj, data in objetos_3d:
        esc = 18.0 / rz
        py = hy + esc * nf
        avia = 48 + esc * (W * 0.68)

        curva_obj = obtener_curvatura(st.get("z") + rz)
        desfase_curva = curva_obj * math.pow(1.0 - esc, 1.85) * (W * 0.42)
        cx_pista = W / 2 - st.get("x") * esc * (W * 0.28) + desfase_curva

        if tipo_obj == "edificio":
            bw, bh = max(14, 150 * esc), max(24, 230 * esc)
            cv.create_rectangle(cx_pista - avia / 2 - 140 * esc - bw / 2, py - bh, cx_pista - avia / 2 - 140 * esc + bw / 2, py, fill="#1e2d42", outline="#0f1722")
            cv.create_rectangle(cx_pista + avia / 2 + 140 * esc - bw / 2, py - bh * 1.15, cx_pista + avia / 2 + 140 * esc + bw / 2, py, fill="#2c3545", outline="#141820")
        elif tipo_obj == "obstaculo":
            px = cx_pista + data.get("x") * (avia * 0.42)
            dibujar_obstaculo(px, py, esc, data.get("tipo"))
        elif tipo_obj == "carro":
            px = cx_pista + data.get("x") * (avia * 0.42)
            dibujar_carro_trafico(px, py, esc, data.get("c"))

    # Dibujar el auto del jugador
    nombre_auto = dibujar_auto(W // 2, H - 72, giro)

    # HUD / Interfaz de usuario
    cv.create_rectangle(14, 14, 335, 118, fill="#0b0f17", outline="#2d3b55", width=2)
    cv.create_text(26, 32, anchor="w", text=f"AUTO: {nombre_auto}", fill="#ffffff", font=("Consolas", 11, "bold"))
    cv.create_text(26, 54, anchor="w", text=f"PISTA: {nom_p}", fill="#7aa2f7", font=("Consolas", 10))
    cv.create_text(26, 76, anchor="w", text=f"VELOCIDAD: {int(st.get('v'))} KM/H", fill="#ff9e64" if st.get("v") > 175 else "#9ece6a", font=("Consolas", 12, "bold"))
    cv.create_text(26, 98, anchor="w", text=f"PUNTOS: {st.get('puntos')}", fill="#e0af68", font=("Consolas", 11, "bold"))

    cv.create_rectangle(W - 310, 14, W - 14, 92, fill="#0b0f17", outline="#2d3b55", width=2)
    cv.create_text(W - 298, 32, anchor="w", text="[WASD / Flechas] Conducir", fill="#cbd5e1", font=("Consolas", 9))
    cv.create_text(W - 298, 50, anchor="w", text="[1,2,3] Pista | [C] Cambiar Auto", fill="#cbd5e1", font=("Consolas", 9))
    cv.create_text(W - 298, 68, anchor="w", text="[L] Luces | [G] Cámara Lenta | [R] Reiniciar", fill="#cbd5e1", font=("Consolas", 9))

    if st.get("volcado"):
        cv.create_rectangle(W // 2 - 220, H // 2 - 55, W // 2 + 220, H // 2 + 45, fill="#111", outline="#ff3333", width=3)
        cv.create_text(W // 2, H // 2 - 20, text="¡AUTO VOLCADO POR CHOQUE!", fill="#ff4444", font=("Consolas", 18, "bold"))
        cv.create_text(W // 2, H // 2 + 15, text="Presiona [R] para reparar y reiniciar", fill="#ffffff", font=("Consolas", 12))

    root.after(16, loop)


try:
    loop()
    root.mainloop()
except Exception:
    traceback.print_exc()
